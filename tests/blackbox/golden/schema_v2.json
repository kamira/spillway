   "budgets",
   "budgets",
   "CREATE TABLE budgets ( deployment_id TEXT PRIMARY KEY REFERENCES deployments(id) ON DELETE CASCADE, type TEXT NOT NULL CHECK (type IN ('usd','credit_pool','none')), limit_amount REAL, window TEXT NOT NULL DEFAULT 'monthly' CHECK (window IN ('monthly','weekly','daily','none')), reset_anchor INTEGER)"
  ],
  [
   "table",
   "cooldowns",
   "cooldowns",
   "CREATE TABLE cooldowns ( deployment_id TEXT PRIMARY KEY REFERENCES deployments(id) ON DELETE CASCADE, exhausted_until TEXT NOT NULL, reason TEXT NOT NULL CHECK (reason IN ('quota_exhausted','rate_limited')) )"
  ],
  [
   "table",
   "deployment_tags",
   "deployment_tags",
   "CREATE TABLE deployment_tags ( deployment_id TEXT NOT NULL REFERENCES deployments(id) ON DELETE CASCADE, tag TEXT NOT NULL, PRIMARY KEY (deployment_id, tag) )"
  ],
  [
   "table",
   "deployments",
   "deployments",
   "CREATE TABLE deployments ( id TEXT PRIMARY KEY, model_name TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('cli','api','local')), provider TEXT NOT NULL, model TEXT NOT NULL, params TEXT NOT NULL DEFAULT '{}', credential_ref TEXT, capabilities TEXT NOT NULL DEFAULT '{}', enabled INTEGER NOT NULL DEFAULT 1 )"
  ],
  [
   "table",
   "groups",
   "groups",
   "CREATE TABLE groups ( name TEXT PRIMARY KEY, selector TEXT NOT NULL )"
  ],
  [
   "table",
   "route_targets",
   "route_targets",
   "CREATE TABLE route_targets ( route_name TEXT NOT NULL REFERENCES routes(name) ON DELETE CASCADE, deployment_id TEXT NOT NULL REFERENCES deployments(id) ON DELETE CASCADE, slot INTEGER NOT NULL, position INTEGER NOT NULL, effort TEXT CHECK (effort IN ('none','low','medium','high','max')), weight TEXT NOT NULL DEFAULT 'medium' CHECK (weight IN ('high','medium','low')), PRIMARY KEY (route_name, deployment_id) )"
  ],
  [
   "table",
   "routes",
   "routes",
   "CREATE TABLE routes ( name TEXT PRIMARY KEY, target TEXT NOT NULL, mode TEXT NOT NULL DEFAULT 'chat' CHECK (mode IN ('chat','task')), tags TEXT NOT NULL DEFAULT '[]', record_context INTEGER, budget_precheck INTEGER NOT NULL DEFAULT 0 )"
  ],
  [
   "table",
   "settings",
   "settings",
   "CREATE TABLE settings ( key TEXT PRIMARY KEY, value TEXT NOT NULL )"
  ],
  [
   "table",
   "usage_ledger",
   "usage_ledger",
   "CREATE TABLE usage_ledger ( id INTEGER PRIMARY KEY, ts TEXT NOT NULL, route_name TEXT, deployment_id TEXT, effort TEXT, tokens_in INTEGER, tokens_out INTEGER, cost_usd REAL, status TEXT NOT NULL, slot INTEGER, fallback_depth INTEGER NOT NULL DEFAULT 0, latency_ms INTEGER, est_tokens_in INTEGER, est_tokens_out_p50 INTEGER, est_tokens_out_p90 INTEGER, est_cost_usd_p90 REAL, error TEXT )"
  ],
